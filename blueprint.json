{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "meta": {
    "title": "Terapie Corporală — demo",
    "description": "Demo of the new site",
    "author": "demo"
  },
  "landingPage": "/",
  "preferredVersions": {
    "php": "8.2",
    "wp": "latest"
  },
  "login": true,
  "features": {
    "networking": true
  },
  "steps": [
    {
      "step": "setSiteOptions",
      "options": {
        "blogname": "Terapie Corporală",
        "permalink_structure": "/%postname%/",
        "blog_public": 0
      }
    },
    {
      "step": "importWxr",
      "file": {
        "resource": "url",
        "url": "https://raw.githubusercontent.com/maximus323/demo-terapie-corporala/main/pagini.xml"
      }
    },
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "url",
        "url": "https://raw.githubusercontent.com/maximus323/demo-terapie-corporala/main/tc-demo-imagini.zip"
      }
    },
    {
      "step": "installTheme",
      "themeData": {
        "resource": "url",
        "url": "https://raw.githubusercontent.com/maximus323/demo-terapie-corporala/main/terapie-corporala.zip"
      }
    },
    {
      "step": "runPHP",
      "code": "<?php require '/wordpress/wp-load.php'; switch_theme('terapie-corporala');"
    },
    {
      "step": "runPHP",
      "code": "<?php require '/wordpress/wp-load.php'; wp_set_current_user(1); if (function_exists('tc_seed_content')) { tc_seed_content(); tc_seed_home_page(); }"
    }
  ]
}